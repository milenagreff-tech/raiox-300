# Copie este arquivo para .env.local (no seu computador) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# NUNCA coloque os valores reais neste arquivo nem no código.

# Endereço público do app (sem barra no final)
APP_URL=https://raio-x.milena.ia.br

# Modo de simulação: true = não envia e-mails de verdade, não gasta coleta nem IA
DRY_RUN=true

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart (Ferramentas > Webhook > hottok)
HOTMART_HOTTOK=
# ID do produto Raio-X na Hotmart (outros produtos são ignorados)
HOTMART_PRODUCT_ID=

# Resend (e-mail)
RESEND_API_KEY=
EMAIL_FROM="Milena IA <eu@milena.ia.br>"
# Para onde vão as respostas dos clientes
EMAIL_REPLY_TO=eu@milena.ia.br
# Onde você recebe os avisos do sistema
ADMIN_EMAIL=eu@milena.ia.br

# Etapa 3: Meta (Business Discovery). O token fica guardado como segredo, nunca aqui.
META_IG_USER_ID=
META_ACCESS_TOKEN=

# Etapa 4: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Etapa 5: senha do painel /admin e segredo das rotinas agendadas
ADMIN_PASSWORD=
CRON_SECRET=
